{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // v2.0 배포 Worker — v1.0(minifia)은 v1 브랜치에서만 배포한다(결정 0043)
  "name": "minifia-v3",
  "compatibility_date": "2026-10-12",
  "main": "./worker/index.ts",
  "upload_source_maps": true,
  // 버전별 미리보기 주소를 만들지 않는다(옛 버전 화면이 열리지 않게, 결정 0042). 다음 배포부터 반영
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "exports": {
    "Room": { "type": "durable-object", "storage": "sqlite" }
  },
  // 판 기록 D1(결정 0089-21). 원격 데이터베이스 id 는 24 배포 첫 단계에서 개인 계정을 확인한 뒤 손으로 넣는다(D-19).
  // `--update-config` 는 주석 있는 jsonc 를 다시 쓸 수 있어 쓰지 않는다. id 가 없는 동안 npm run deploy 는 배포 가드가 멈춘다.
  "d1_databases": [{ "binding": "DB", "database_name": "minifia-v3-games", "migrations_dir": "migrations" }]
}
