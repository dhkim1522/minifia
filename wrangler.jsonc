{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // v2.0 배포 Worker — v1.0(minifia)은 v1 브랜치에서만 배포한다(결정 0043)
  "name": "minifia-v3",
  "compatibility_date": "2026-10-12",
  "main": "./worker/index.ts",
  "upload_source_maps": true,
  // 버전별 미리보기 주소를 만들지 않는다(옛 버전 화면이 열리지 않게, 결정 0042). 다음 배포부터 반영
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "exports": {
    "Room": { "type": "durable-object", "storage": "sqlite" }
  },
  // 개인 Cloudflare 계정의 v3 판 기록 D1(결정 0089-21·0091-18).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minifia-v3-games",
      "database_id": "2c0916ab-376e-4b5e-8ffb-952546db14f3",
      "migrations_dir": "migrations"
    }
  ]
}
